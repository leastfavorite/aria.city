'use client';

import styles from "./page.module.css";
import { MouseEvent, PropsWithChildren, Ref, useCallback, useEffect, useRef } from "react";
import World, { WorldPhysicsSettings, WorldRenderSettings } from "./physics/World";
import { useTweaks } from "use-tweaks";
import { useAnimationFrame } from "motion/react";

export function PhysicsFrame({ children }: PropsWithChildren) {

  const physicsSettings = useTweaks("Physics Settings", {
    d: { min: 0, max: 2, value: 1 },
    k: { min: 0, max: 1, value: 0.0005 },
    damp: { min: 0, max: 1, value: 0.99 }
  }) as WorldPhysicsSettings;

  // idk why it cant infer this type already?
  const renderSettings = useTweaks("Render Settings", {
    massSize: { min: 1, value: 3, max: 20 },
    massColor: { r: 255, g: 255, b: 255 }
  }) as WorldRenderSettings;

  const canvasRef: Ref<HTMLCanvasElement> = useRef(null);

  const ctxRef: Ref<CanvasRenderingContext2D> = useRef(null);
  const containerRef: Ref<HTMLDivElement> = useRef(null);
  const worldRef: Ref<World> = useRef(new World());

  const onResize = useCallback(() => {
    const canvas = canvasRef.current;
    const container = containerRef.current;
    const world = worldRef.current;

    if (!container) return;

    const w = container.clientWidth;
    const h = container.clientHeight;

    if (canvas) {
      canvas.width = w;
      canvas.height = h;
    }

    if (world) {
      world.setSize(w, h);
    }

  }, [canvasRef, containerRef, worldRef]);

  // resize logic
  useEffect(() => {
    window.addEventListener('resize', onResize)
    onResize()
    return () => window.removeEventListener('resize', onResize);
  }, [])

  useAnimationFrame(useCallback((_, dt) => {
    const world = worldRef.current;
    const canvas = canvasRef.current;
    const ctx = ctxRef.current;

    if (!canvas || !world || !ctx) {
      return;
    }

    world.update(dt, physicsSettings)
    world.render(ctx, renderSettings)
  }, [worldRef, canvasRef, ctxRef, physicsSettings, renderSettings]))

  useEffect(() => {
    ctxRef.current = canvasRef.current?.getContext("2d") || null;
  }, [canvasRef]);

  const handleClick = useCallback((event: MouseEvent) => {
    const world = worldRef.current;
    if (world) {
      world.addPoint(event.pageX, event.pageY);
    }
  }, [worldRef])


  return (
    <div className={styles.container} onClick={handleClick} ref={containerRef}>
      <canvas ref={canvasRef} />
    </div>
  );
}

export default function Home() {

  return (
    <PhysicsFrame />
  );
}
